{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super PM",
  "version": "0.1.2",
  "identifier": "app.superpm.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pmproj"
        ],
        "name": "Super PM Project",
        "description": "Super PM Project",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "app.superpm.desktop.project",
          "conformsTo": [
            "public.data",
            "public.database"
          ]
        }
      }
    ],
    "copyright": "Copyright © 2026 Laouen. Licensed under the GNU AGPL 3.0."
  }
}
